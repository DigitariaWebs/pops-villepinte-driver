{
  "expo": {
    "name": "POP'S Driver",
    "slug": "pops-villepinte-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "popsdriver",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.progix.popsvillepintedriver",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "POP'S Driver utilise votre position pour vous guider vers les clients en livraison.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "POP'S Driver suit votre position pour vous guider en temps réel pendant les livraisons, même en arrière-plan.",
        "UIBackgroundModes": [
          "location",
          "audio",
          "fetch"
        ],
        "MBXAccessToken": "pk.your_public_token_here"
      }
    },
    "android": {
      "package": "com.progix.popsvillepintedriver",
      "adaptiveIcon": {
        "backgroundColor": "#FFCE00",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f2b40a",
          "image": "./assets/images/pops-logo.png",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "POP'S Driver utilise votre position pour vous guider en temps réel pendant les livraisons.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsImpl": "mapbox",
          "RNMapboxMapsVersion": "11.11.0",
          "RNMapboxMapsDownloadToken": "sk.your_secret_downloads_token_here"
        }
      ],
      [
        "@badatgil/expo-mapbox-navigation",
        {
          "accessToken": "pk.your_public_token_here",
          "mapboxMapsVersion": "11.11.0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "mapboxPublicToken": "PLACEHOLDER_OVERRIDE_FROM_ENV",
      "eas": {
        "projectId": "23c6a0c9-b411-45dc-80e0-0b9ca5cc8929"
      }
    },
    "owner": "achrefdev"
  }
}
