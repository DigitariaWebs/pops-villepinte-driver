# =============================================================================
# POP'S Driver — environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Mapbox
# -----------------------------------------------------------------------------
# 1) PUBLIC ACCESS TOKEN (starts with "pk.")
#    Used at runtime by the maps & navigation SDKs. Safe to ship in the app
#    bundle, but restrict it to your app's bundle IDs in the Mapbox dashboard.
#    Created at: https://console.mapbox.com/account/access-tokens/
EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=pk.your_public_token_here

# 2) DOWNLOADS / SECRET TOKEN (starts with "sk.")
#    Required ONLY at build time so EAS / Gradle / CocoaPods can pull the
#    Mapbox native SDK artifacts. Must have the `Downloads:Read` scope.
#    NEVER expose this to the JS bundle (no EXPO_PUBLIC_ prefix).
MAPBOX_DOWNLOADS_TOKEN=sk.your_secret_downloads_token_here

# -----------------------------------------------------------------------------
# Backend / API (placeholder — fill in once the driver backend is wired)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
