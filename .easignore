# EAS Build only needs the React Native / Expo driver app. Everything else in
# this folder (Nest API, supabase migrations, admin scratch) is unrelated and
# bloats the upload tarball.

# Sibling sub-projects — not part of the driver mobile build
server/
pops_superadmin/

# Cruft / IDE / scratch
.git/
.expo/
.vscode/
.idea/

# Native build outputs (regenerated by EAS Build via prebuild)
android/
ios/

# Standard dep / build caches
node_modules/
dist/
build/
.next/
coverage/
*.tsbuildinfo
*.log

# Local env / secrets. .env.production IS uploaded (omitted from this list)
# so that EAS has all prod values in one self-contained file.
.env
.env.local
.env.*.local
